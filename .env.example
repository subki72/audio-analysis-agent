# Groq API Configuration
# Obtain an API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_api_key_here

# Model for audio analysis agent (tool calling & reasoning)
GROQ_MODEL=llama-3.3-70b-versatile

# Groq API base URL (optional; SDK appends /openai/v1 automatically)
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Agent safety & reliability settings
MAX_ITERATIONS=10
API_TIMEOUT_SECONDS=60
RATE_LIMIT_CALLS_PER_MINUTE=30

# Optional explicit binary paths (auto-discovered via PATH / Conda if empty)
FFMPEG_PATH=
FFPROBE_PATH=

# Structured logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
